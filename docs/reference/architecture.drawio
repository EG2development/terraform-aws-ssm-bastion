        <mxCell id="c2" value="terraform-aws-ssm-bastion — architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="An EC2 instance with no inbound access, no key pair and no public IP, reached only through Systems Manager." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#545B64;spacing=4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1354" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;&lt;b&gt;name&lt;/b&gt; — required&lt;br&gt;&lt;b&gt;vpc_id&lt;/b&gt; — required&lt;br&gt;&lt;b&gt;subnet_id&lt;/b&gt; — required&lt;br&gt;instance_type = &quot;t4g.nano&quot;&lt;br&gt;ami_id = null&lt;br&gt;ami_ssm_parameter_name = Amazon Linux 2023 arm64 (public SSM parameter)&lt;br&gt;user_data = null&lt;br&gt;root_volume_size = 8&lt;br&gt;root_volume_kms_key_arn = null&lt;br&gt;egress_cidr_blocks = [&quot;0.0.0.0/0&quot;]&lt;br&gt;tags = {}" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EAF3FB;strokeColor=#147EBA;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;instance_id&lt;br&gt;private_ip&lt;br&gt;security_group_id&lt;br&gt;iam_role_name&lt;br&gt;iam_role_arn&lt;br&gt;instance_profile_name" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EEF6E8;strokeColor=#7AA116;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="100" width="294" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;IAM the module creates&lt;/b&gt;&lt;br&gt;aws_iam_role.bastion — trusted by ec2.amazonaws.com.&lt;br&gt;One managed policy, AmazonSSMManagedInstanceCore: the SSM Agent registers, takes Session Manager, port-forwarding and Run Command traffic over ssmmessages and ec2messages, and reports inventory; it also allows ssm:GetParameter and ssm:GetParameters on the account's parameters.&lt;br&gt;Nothing else." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="231" width="294" height="176" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Requirements&lt;/b&gt;&lt;br&gt;Terraform ≥ 1.9.0 · hashicorp/aws ≥ 6.0&lt;br&gt;No provider block: the caller's provider sets the account, the Region and default_tags." style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="423" width="294" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Only when … — created only when the condition holds" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#879196;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontStyle=2;fontSize=10;fontColor=#232F3E;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="1320" y="515" width="294" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Grey — not created by the module: the caller's, or AWS's" style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#F1F3F3;strokeColor=#5A6C86;dashed=0;fontSize=10;fontColor=#232F3E;align=left;verticalAlign=top;spacing=6;spacingTop=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="559" width="294" height="30" as="geometry" />
        </mxCell>
